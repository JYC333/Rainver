# Development environment template.
# scripts/start.sh --dev copies this to $RAINVER_ROOT/dev/.env on first run.
# Edit the copied file, not this template.

POSTGRES_MAJOR=18
POSTGRES_DB=rainver
POSTGRES_USER=rainver
POSTGRES_PASSWORD=rainver_dev_password
# DATABASE_URL=postgresql://rainver:rainver_dev_password@localhost:5432/rainver

# start.sh/migrate.sh generate the bundled-postgres owner DB URL and internal token.
# SERVER_DATABASE_URL=<auto-generated from POSTGRES_* by ops scripts>
# SERVER_INTERNAL_TOKEN=<auto-generated by ops scripts>
# BETTER_AUTH_SECRET=<auto-generated by ops scripts>

# Optional runtime tool npm install network config. Leave these unset when the
# server container can reach the npm registry directly. If a proxy runs on the
# host, use an address reachable from the container. The dev compose file maps
# host.docker.internal to the Docker host.
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# ALL_PROXY=socks5h://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,postgres,server,frontend,deployer
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# Optional exact hostname for the dev Vite server behind a private reverse proxy.
# Hostname only, without scheme or port; Vite 6 accepts one additional host here.
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=desktop.example.ts.net

# Google OAuth local defaults
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback/google

# Personal read-only Gmail connections (optional; server process only).
# A dedicated Web OAuth client is recommended. You can also reuse the Google
# sign-in client ID and secret. Set all three Gmail variables or none.
# Register the Gmail callback below as an authorized redirect URI on that
# client. If reusing the sign-in client, keep its sign-in redirect URI too.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/sources/gmail/oauth/callback
# Optional Gmail push for new-mail monitors (all four or none; needs the Gmail
# client above). Use a Pub/Sub topic and push subscription in the SAME Google
# Cloud project as that OAuth client (Gmail refuses another project's topic);
# grant gmail-api-push@system.gserviceaccount.com publish on the topic. The push
# subscription calls the HTTPS endpoint below with an OIDC token for this
# audience and service account. Without these, monitors are checked on a schedule.
# GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic>
# GMAIL_PUBSUB_SUBSCRIPTION=projects/<project-id>/subscriptions/<subscription>
# GMAIL_PUBSUB_PUSH_AUDIENCE=https://<public-origin>/api/v1/sources/gmail/push
# GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=<name>@<project-id>.iam.gserviceaccount.com
# FRONTEND_URL=http://localhost:3000

# Required to use the Instance Settings and runtime-tool administration UI.
# INSTANCE_ADMIN_EMAIL=
# The first registration must match INSTANCE_ADMIN_EMAIL; later registration requires an invitation.

# Optional deployment capability. Schedule, retention, log inclusion, and
# access-log retention are managed in Instance Settings after startup.
# BACKUP_ENABLED=true
# Deployment-only storage/connection overrides:
# BACKUP_ROOT=
# BACKUP_DATABASE_URL=
