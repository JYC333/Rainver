{
  "name": "@rainver/host-daemon",
  "version": "0.4.0",
  "description": "Thin execution-host bridge for ADR 0016: registers a personal machine with an Rainver control plane, registers pre-existing directories as trusted-host workspaces, and holds an outbound heartbeat connection. No planner, no memory, no business logic \u2014 see .agent/decisions/0016-control-plane-execution-hosts.md.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "rainver-host": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:workspace-deps": "pnpm --filter @rainver/protocol --filter @rainver/outbound-guard --filter @rainver/folder-read --filter @rainver/agent-cli build",
    "pretypecheck": "pnpm run build:workspace-deps",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm run build:workspace-deps",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rainver/agent-cli": "workspace:*",
    "@rainver/folder-read": "workspace:*",
    "@rainver/outbound-guard": "workspace:*",
    "@rainver/protocol": "workspace:*"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@agentclientprotocol/codex-acp": "1.12.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
