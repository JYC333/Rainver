{
  "name": "@rainver/agent-cli",
  "version": "0.1.0",
  "description": "The Run-scoped rainver command and local Host tool bridge: list, describe, call. No runtime dependencies; authorization remains with the control plane.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "rainver": "./dist/rainver.js"
  },
  "main": "./dist/rainver.js",
  "types": "./dist/rainver.d.ts",
  "exports": {
    ".": "./dist/rainver.js",
    "./source": "./src/rainver.ts",
    "./local-bridge": { "types": "./dist/localBridge.d.ts", "default": "./dist/localBridge.js" },
    "./tool-http": { "types": "./dist/toolHttp.d.ts", "default": "./dist/toolHttp.js" }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
