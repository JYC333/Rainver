{
  "name": "@rainver/server",
  "version": "0.0.1",
  "description": "Client-facing backend for rainver.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:workspace-deps": "pnpm --filter @rainver/protocol --filter @rainver/outbound-guard --filter @rainver/folder-read build",
    "pretypecheck": "pnpm run build:workspace-deps",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsc -p tsconfig.json",
    "build:official-plugins": "node scripts/build-official-plugins.mjs",
    "postbuild": "pnpm run build:official-plugins",
    "start": "node dist/index.js",
    "pretest": "pnpm run build:workspace-deps",
    "test": "vitest run",
    "pretest:watch": "pnpm run build:workspace-deps",
    "test:watch": "vitest",
    "migrate": "pnpm run build && node dist/db/migrateCli.js up",
    "migrate:status": "pnpm run build && node dist/db/migrateCli.js status",
    "auth:recovery": "pnpm run build && node dist/modules/auth/recoveryCli.js",
    "schema:generate": "node scripts/db/schema-migrations.mjs generate",
    "schema:check": "node scripts/db/schema-migrations.mjs check && drizzle-kit check --config=drizzle.config.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@earendil-works/pi-ai": "^0.84.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "2.2.1",
    "@rainver/folder-read": "workspace:*",
    "@rainver/outbound-guard": "workspace:*",
    "@rainver/protocol": "workspace:*",
    "better-auth": "1.7.5",
    "cron-parser": "^5.10.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.2.0",
    "pg": "^8.21.0",
    "undici": "^6.21.0",
    "unpdf": "^1.6.2",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.0.2",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
