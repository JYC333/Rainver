#!/bin/sh
set -eu
test "$(cat /workspace/allowed.txt)" = "selected-project"
test "$(cat /workspace/runtime-context.txt)" = "generated-delivery"
for forbidden in \
  /rainver \
  /runner \
  /repo \
  /app/server \
  /home/node \
  /var/lib/postgresql \
  /var/log \
  /var/run/docker.sock
do
  test ! -e "$forbidden"
done
test ! -e /workspace/../other/secret.txt
! touch /workspace/new-top-level-entry 2>/dev/null
printf 'sandbox-boundary-ok\n'
